<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>embedded</DebugType>
    <UserSecretsId>dotnet-FSharp.DiscordBot.Template-f9ee9695-8832-4354-b98f-58c552ad16bf</UserSecretsId>
  </PropertyGroup>


  <ItemGroup>
    <Compile Include="Handlers.fs" />
    <Compile Include="BotService.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
</Project>